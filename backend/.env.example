DB_HOST=qshift-mysql-qshift.c.aivencloud.com
DB_PORT=26796
DB_USER=avnadmin
DB_PASSWORD=your_password_here
DB_NAME=defaultdb
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_CONNECTION_LIMIT=3
DB_MAX_IDLE=3
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=30000
DB_QUERY_RETRY_ATTEMPTS=6
FRONTEND_URL=https://qshift.vercel.app
# Or allow multiple deployed frontends:
# FRONTEND_URLS=https://qshift.vercel.app,https://your-preview.vercel.app
PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_here
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_MS=90000
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Email/OTP notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=minh.quyetstt1@gmail.com
SMTP_PASS=your_email_password_here
SMTP_FROM="Qshift <minh.quyetstt1@gmail.com>"
